{
  "name": "lions-cms-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs'); const path=require('path'); const src=path.join(process.cwd(),'prisma'); const dest=path.join(process.cwd(),'dist','prisma'); fs.cpSync(src,dest,{recursive:true,force:true});\"",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "lint": "tsc --noEmit"
  },
  
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.13.1",
    "slugify": "^1.6.6",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "tsx":"^4.19.1",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.0",
    "@types/sanitize-html": "^2.13.0",
    "@types/uuid": "^9.0.8",
    "prisma": "^5.20.0"
  },
  "prisma": {
  "seed": "tsx prisma/seed.ts"
}
}
